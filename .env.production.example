# ═══════════════════════════════════════════════════════════════════════
# DocWise — Production Environment Variables
# Copy to .env and fill in real values before deploying.
# ═══════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=kagaz
POSTGRES_DB=kagaz
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password

# ─── MinIO (S3-compatible storage) ───────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key
MINIO_BUCKET=kagaz-files

# ─── Public URLs (replace YOUR_DOMAIN_OR_IP with your server's IP or Domain) ────
# MinIO presigned URLs are signed for this host and proxied via Nginx at /storage/
# Keep this as host only (no http/https), e.g. 203.0.113.10 or app.example.com
MINIO_PUBLIC_ENDPOINT=YOUR_DOMAIN_OR_IP
# Use the public origin users open in the browser
NEXT_PUBLIC_API_URL=http://YOUR_DOMAIN_OR_IP
CORS_ORIGINS=["http://YOUR_DOMAIN_OR_IP"]

# ─── Cerebras — Chat / Summarization ────────────────────────────────
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CHAT_MODEL=gpt-oss-120b
CEREBRAS_DEEP_MODEL=zai-glm-4.7
CEREBRAS_REASONING_EFFORT=low
CEREBRAS_CHAT_REASONING_EFFORT=low
CEREBRAS_DEEP_REASONING_EFFORT=high

# OpenRouter chat provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=DocWise

# Tavily web research for Agent mode
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=6

# Bounded read-only Agent mode. Enable only after migration and canary checks.
AGENT_TOOLS_ENABLED=false
AGENT_CREDIT_SURCHARGE=2
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_WEB_SEARCHES=2
AGENT_MAX_WEB_INSPECTIONS=2
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOTAL_TIMEOUT_SECONDS=150
AGENT_MAX_TOOL_RESULT_CHARS=16000
CEREBRAS_API_VERSION_PATCH=2

CHAT_DAILY_LIMIT_PER_USER=30

# ─── Local Document Embeddings ──────────────────────────────────────
# Free local embeddings. First container build/run downloads this model.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=bge-small-en-v1.5-v1
LEGACY_FAISS_DUAL_WRITE=true

# Conversation recovery and provider timeouts
STREAM_EVENT_TTL_SECONDS=900
CHAT_SUMMARY_MESSAGE_THRESHOLD=12
CHAT_SUMMARY_CONTEXT_PERCENT=25
CHAT_PROVIDER_CONNECT_TIMEOUT_SECONDS=10
CHAT_PROVIDER_READ_TIMEOUT_SECONDS=120
CHAT_PROVIDER_TOTAL_TIMEOUT_SECONDS=180
CHAT_PROVIDER_MAX_RETRIES=1
CHAT_CIRCUIT_FAILURE_THRESHOLD=5
CHAT_CIRCUIT_RESET_SECONDS=30
CHAT_HEARTBEAT_SECONDS=15
CHAT_RETRIEVAL_LIMIT=10
CHAT_RETRIEVAL_CANDIDATES=30
PROCESSING_STALE_AFTER_SECONDS=600
REQUIRED_SCHEMA_REVISION=0002_agent_tools

# ─── Transcription for Audio/Video ──────────────────────────────────
# Optional. PDFs and chat do not need this. Audio/video transcription still needs
# either Azure Whisper or OPENAI_API_KEY until a local STT service is added.
AZURE_OPENAI_WHISPER_API_KEY=
AZURE_OPENAI_WHISPER_ENDPOINT=
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_WHISPER_API_VERSION=2024-06-01
OPENAI_API_KEY=

# ─── Clerk Auth ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
